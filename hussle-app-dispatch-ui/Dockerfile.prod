# ============================================
# Builder Stage - Build Vite bundle
# ============================================
FROM node:22-alpine AS builder
WORKDIR /usr/app

# Copy package files
COPY package*.json ./

# Install all dependencies (including devDependencies for Vite build)
RUN npm ci

# VITE_API_URL is baked into the bundle at build time
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# Copy source code
COPY . .

# Build the Vite bundle (outputs to dist/)
RUN npm run build

# ============================================
# Runner Stage - Nginx Static File Server
# ============================================
FROM nginxinc/nginx-unprivileged:alpine AS runner

# Copy built static assets from builder
COPY --from=builder /usr/app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

# Health check — wget is available in nginx-unprivileged:alpine
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/index.html || exit 1
