# Anthropic API key — required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Shared secret with the Node API for the X-Internal-Token header.
# In Phase 0 (local POC) the default 'dev' is accepted so you can curl freely.
INTERNAL_TOKEN=dev

# Model used for ratecon extraction. Override to experiment.
RATECON_MODEL=claude-sonnet-4-6

# Max upload size in bytes (10 MB).
MAX_UPLOAD_BYTES=10485760
