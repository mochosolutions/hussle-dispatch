# Server
PORT=3001
NODE_ENV=development

# Database (use container hostname for Docker)
DATABASE_URL=postgresql://postgres:postgres@hussle-app-postgres:5432/hussle_dispatch

# Redis (use container hostname for Docker)
REDIS_URL=redis://hussle-app-redis:6379

# RabbitMQ (use container hostname for Docker)
RABBITMQ_URL=amqp://guest:guest@hussle-app-rabbitmq:5672

# File watching (Docker volume mounts)
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=300

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
REFRESH_SECRET=your-refresh-secret

# AWS Cognito
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_USER_POOL_ID=your-cognito-user-pool-id

# AWS Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS S3
S3_BUCKET=your-s3-bucket-name

# AWS SES (email)
# Set SES_FROM_EMAIL to enable SES email backend (e.g. invoices@notify.yourdomain.com)
# When empty, emails are logged to console (dev mode)
SES_FROM_EMAIL=

# SMTP (local email testing via Mailpit)
# Set SMTP_HOST to enable SMTP backend (falls back to console if unset)
SMTP_HOST=hussle-app-mailpit
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# SMS (Twilio)
# Set SMS_BACKEND=twilio to enable real SMS delivery
# When 'console' (default), SMS messages are logged instead of sent
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Frontend URL (for invite links, etc.)
FRONTEND_URL=http://localhost:5173

# AWS Location Service
AWS_LOCATION_PLACE_INDEX_NAME=your-place-index-name
AWS_LOCATION_ROUTE_CALCULATOR_NAME=your-route-calculator-name
AWS_LOCATION_MAP_NAME=your-map-name
ROUTE_CALCULATOR_ENABLED=true
