# Server
PORT=3001
NODE_ENV=development

# Environment identity — required by destructive scripts (clear-tenant-data, etc.)
# Allowed values: local, dev, staging, prod, production
# Scripts hard-refuse against 'prod*' and 'unknown' regardless of other flags.
ENVIRONMENT_NAME=local

# Database (use container hostname for Docker)
DATABASE_URL=postgresql://postgres:postgres@hussle-app-postgres:5432/hussle_dispatch

# Redis (use container hostname for Docker)
REDIS_URL=redis://hussle-app-redis:6379

# RabbitMQ (use container hostname for Docker)
RABBITMQ_URL=amqp://guest:guest@hussle-app-rabbitmq:5672

# File watching (Docker volume mounts)
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=300

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
REFRESH_SECRET=your-refresh-secret

# AWS Cognito
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_USER_POOL_ID=your-cognito-user-pool-id

# AWS Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Storage backend — 'local' (dev/test filesystem) or 's3' (production)
# Set to 's3' to use real S3 for documents, receipts, invoice PDFs
STORAGE_BACKEND=local

# AWS S3
S3_BUCKET=your-s3-bucket-name

# AWS SES (email)
# Set SES_FROM_EMAIL to enable SES email backend (e.g. invoices@notify.yourdomain.com)
# When empty, emails are logged to console (dev mode)
SES_FROM_EMAIL=

# SMTP (local email testing via Mailpit)
# Set SMTP_HOST to enable SMTP backend (falls back to console if unset)
SMTP_HOST=hussle-app-mailpit
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# SMS (Twilio)
# Set SMS_BACKEND=twilio to enable real SMS delivery
# When 'console' (default), SMS messages are logged instead of sent
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Frontend URL (for invite links, etc.)
FRONTEND_URL=http://localhost:5173

# Comma-separated list of Chrome extension IDs allowed by CORS.
# Leave empty to reject all chrome-extension:// origins.
ALLOWED_EXTENSION_IDS=

# Public base URL for SMS short-link redirects (GET /s/:slug). Driver SMS messages embed `${PUBLIC_SHORT_BASE_URL}/s/<slug>`.
PUBLIC_SHORT_BASE_URL=http://localhost:3001

# AWS Location Service v2 (geo-places, geo-routes, geo-maps).
# v2 SDK clients are keyed only by region + credentials — no named place index / route
# calculator resources required (those were v1 concepts, removed in Phase 0 cleanup).
# AWS_LOCATION_MAP_NAME is retained as a feature-flag for the maps tile path; any
# truthy value enables the real provider, empty falls back to a stub. The value itself
# is not sent to AWS.
AWS_LOCATION_MAP_NAME=your-map-name
ROUTE_CALCULATOR_ENABLED=true

# Document signing (carrier dispatch agreements)
# Provider selection — 'mock' (deterministic, dev/test) or 'docuseal' (real provider)
SIGNATURE_PROVIDER=mock

# DocuSeal — required when SIGNATURE_PROVIDER=docuseal
# Base URL of the DocuSeal instance (self-hosted or cloud)
DOCUSEAL_BASE_URL=
# DocuSeal API key (server-side, never exposed to clients)
DOCUSEAL_API_KEY=
# HMAC secret used to verify inbound DocuSeal webhooks (POST /webhooks/docuseal)
DOCUSEAL_WEBHOOK_SECRET=

# Agreement watchdog — periodic sweep that republishes signed-but-unprocessed agreements
# Interval between sweeps (minutes)
AGREEMENT_WATCHDOG_INTERVAL_MIN=5
# Age threshold beyond which a PENDING agreement is considered stale (minutes)
AGREEMENT_WATCHDOG_STALE_THRESHOLD_MIN=10
