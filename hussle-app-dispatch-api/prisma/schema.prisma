// This is the Prisma schema for hussle-app-dispatch-api.
// All entity IDs use uuid (L-009).
// Organization and User are minimal stubs — will be replaced when auth package is integrated.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth models — integrated from mocho-solutions auth module
// ---------------------------------------------------------------------------

model Organization {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  email               String
  description         String?
  phoneNumber         String?
  address             String?
  website             String?
  logo                String?
  vertical            OrganizationVertical @default(LOGISTICS)
  role                OrganizationRole     @default(CARRIER)
  status              OrganizationStatus   @default(PENDING)
  subscriptionTier    SubscriptionTier     @default(TRIAL)
  deleted             Boolean              @default(false)
  deletedAt           DateTime?
  customFields        Json?
  resources           Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         Membership[]
  invitations         Invitation[]
  managedCarriers     Carrier[]            @relation("ManagedCarriers")
  carrierOrgs         Carrier[]            @relation("CarrierOrg")
  contacts            Contact[]
  loads               Load[]
  places              Place[]
  documents           Document[]
  orgSettings         OrgSettings?
  customers           Customer[]
  carrierInviteTokens CarrierInviteToken[]
  expenses            Expense[]
  recurringExpenses   RecurringExpense[]
  settlements         Settlement[]
  loans               Loan[]

  @@index([slug])
  @@index([deleted, status])
}

model User {
  id                 String              @id @default(uuid())
  externalId         String              @unique
  email              String              @unique
  firstName          String
  lastName           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        Membership[]        @relation("UserMemberships")
  invitedMemberships Membership[]        @relation("InvitedBy")
  invitations        Invitation[]
  statusChanges      LoadStatusHistory[]
  checkCalls         CheckCall[]

  @@index([externalId])
  @@index([email])
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           String
  status         String       @default("active")
  invitedById    String?
  deleted        Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation("UserMemberships", fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  invitedBy          User?              @relation("InvitedBy", fields: [invitedById], references: [id])
  dispatcherProfile  DispatcherProfile?

  @@unique([userId, organizationId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  firstName      String?
  lastName       String?
  role           String
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  invitedBy      User             @relation(fields: [invitedById], references: [id])

  @@unique([organizationId, email])
  @@index([token])
  @@index([status, expiresAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  organizationId String
  action         String
  entityType     String
  entityId       String
  changes        Json?
  metadata       Json?
  timestamp      DateTime @default(now())

  @@index([organizationId, timestamp])
  @@index([userId])
}

