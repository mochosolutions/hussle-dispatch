# ============================================
# Builder Stage - Compile TypeScript
# ============================================
FROM node:22-alpine AS builder
WORKDIR /usr/app

# Install build dependencies for native modules and Prisma on Alpine Linux
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    openssl

# Copy package files and Prisma schema
COPY package*.json ./
COPY prisma ./prisma/

# Install all dependencies (including devDependencies for TypeScript compilation)
RUN npm ci

# Generate Prisma client with platform-specific binaries for Alpine Linux
# This MUST happen BEFORE TypeScript compilation (src imports from generated client)
RUN npx prisma generate

# Copy source code and build configuration
COPY . .

# Compile TypeScript to JavaScript
RUN npm run build

# ============================================
# Runner Stage - Production Runtime
# ============================================
FROM node:22-alpine AS runner
WORKDIR /usr/app

# Install runtime dependencies only (openssl for Prisma, postgresql-client for psql in migrate-and-start.sh)
RUN apk add --no-cache \
    openssl \
    postgresql-client

# Set production environment
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}

# Copy package files and Prisma schema (needed for prisma migrate deploy)
COPY package*.json ./
COPY prisma ./prisma/

# Install ONLY production dependencies
RUN npm ci --omit=dev --ignore-scripts

# Copy compiled JavaScript from builder stage
COPY --from=builder /usr/app/dist ./dist

# Copy platform-specific Prisma engine binary generated in builder stage
# The schema uses default prisma-client-js output (node_modules/.prisma/client)
# --ignore-scripts skips postinstall prisma generate, so we copy the binary directly
COPY --from=builder /usr/app/node_modules/.prisma ./node_modules/.prisma

# Copy migration startup script
COPY scripts/migrate-and-start.sh ./scripts/migrate-and-start.sh
RUN chmod +x ./scripts/migrate-and-start.sh

USER node

EXPOSE 3001

# Health check for container orchestration
# Increased start-period to 60s to allow time for migrations
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Run migrations and start the server
CMD ["./scripts/migrate-and-start.sh"]
