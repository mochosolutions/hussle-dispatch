exports[`renderDispatchAgreement snapshot of rendered HTML is stable 1`] = `"<!DOCTYPE html><html dir="ltr" lang="en"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/></head><body style="font-family:Helvetica, Arial, sans-serif;color:#222"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:37.5em"><tbody><tr style="width:100%"><td><h1>Dispatch Service Agreement</h1><p style="font-size:14px;line-height:24px;margin-bottom:16px;margin-top:16px">This Dispatch Service Agreement (&quot;Agreement&quot;) is entered into on 2026-06-01 between FleetCommand (&quot;Broker&quot;) and Acme Trucking LLC (MC# 123456, DOT# 7890123) (&quot;Carrier&quot;).</p><p style="font-size:14px;line-height:24px;margin-bottom:16px;margin-top:16px">Carrier agrees to dispatch services as described in Schedule A, attached and incorporated by reference.</p><p style="font-size:14px;line-height:24px;margin-bottom:16px;margin-top:16px">Carrier signature: {{signer1.signature}}</p><p style="font-size:14px;line-height:24px;margin-bottom:16px;margin-top:16px">Date: {{signer1.date}}</p></td></tr></tbody></table></body></html>"`;
