FROM node:22-alpine

WORKDIR /usr/app

RUN apk add --no-cache openssl

COPY package*.json ./
COPY prisma ./prisma/

COPY package.json package-lock.json ./

RUN npm install


# Generate Prisma client with platform-specific binaries for the container
# This MUST happen after npm install (which installs @prisma/client)
# and BEFORE copying source code (which imports from generated client)
RUN npx prisma generate

COPY . .


# Run migrations and start dev server with hot reload
# Using 'sh' to run the script since volume mount may override execute permissions
CMD ["sh", "./scripts/migrate-and-start.sh", "--dev"]
