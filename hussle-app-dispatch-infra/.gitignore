# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.env.*
*.sqlite3
*.db
*.log

# VSCode
.vscode/
.history/

# macOS
.DS_Store

# Terraform
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.backup
*.tfstate
*.tfstate.*
crash.log
*.tfplan

# Terraform variables - ignore secrets only
*.auto.tfvars
*secrets.tfvars
*secrets.tfvars.json
environments/*/terraform.tfvars.secrets
environments/*/.terraform.tfvars.secrets

# Allow base and template files
!*.tfvars.example
!*.tfvars.template
!environments/base/terraform.tfvars.json
!environments/base/terraform.tfvars

# Environment-specific tfvars (review these - commit if non-sensitive)
# Uncomment to ignore all environment tfvars:
# environments/*/terraform.tfvars.json
# environments/*/terraform.tfvars

