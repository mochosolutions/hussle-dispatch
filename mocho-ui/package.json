{
	"name": "@mocho/ui",
	"version": "0.1.0",
	"description": "Unified shared UI library for Mocho Solutions React applications",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./redux": {
			"types": "./dist/types/redux/index.d.ts",
			"import": "./dist/redux/index.js",
			"require": "./dist/redux/index.cjs"
		},
		"./forms": {
			"types": "./dist/types/forms/index.d.ts",
			"import": "./dist/forms/index.js",
			"require": "./dist/forms/index.cjs"
		},
		"./components": {
			"types": "./dist/types/components/index.d.ts",
			"import": "./dist/components/index.js",
			"require": "./dist/components/index.cjs"
		},
		"./theme": {
			"types": "./dist/types/theme/index.d.ts",
			"import": "./dist/theme/index.js",
			"require": "./dist/theme/index.cjs"
		},
		"./hooks": {
			"types": "./dist/types/hooks/index.d.ts",
			"import": "./dist/hooks/index.js",
			"require": "./dist/hooks/index.cjs"
		},
		"./utils": {
			"types": "./dist/types/utils/index.d.ts",
			"import": "./dist/utils/index.js",
			"require": "./dist/utils/index.cjs"
		},
		"./types": {
			"types": "./dist/types/types/index.d.ts"
		}
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "storybook dev -p 6006",
		"build": "tsc && vite build",
		"build:storybook": "storybook build -o storybook-static",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"check-ts": "npm run type-check",
		"type-check": "tsc --noEmit",
		"lint:deps": "dependency-cruiser --config .dependency-cruiser.cjs src",
		"lint": "eslint src/ --ext .ts,.tsx",
		"validate": "npm run lint && npm run lint:deps && npm run check-ts && npm test",
		"clean": "rm -rf dist",
		"prepublishOnly": "npm run clean && npm run build",
		"preview:storybook": "npx http-server storybook-static"
	},
