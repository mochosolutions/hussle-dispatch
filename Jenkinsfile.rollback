pipeline {
  agent any

  parameters {
    choice(
      name: 'SERVICE',
      choices: ['api', 'ui', 'emails', 'rabbitmq'],
      description: 'Service to roll back'
    )
    string(
      name: 'TARGET_TAG',
      defaultValue: '',
      description: 'ECR image tag to roll back to (leave blank to list recent tags)'
    )
    choice(
      name: 'ENVIRONMENT',
      choices: ['prod', 'staging', 'dev'],
      description: 'Target environment'
    )
  }

  environment {
    AWS_REGION        = 'us-east-1'
    ECR_REGISTRY      = credentials('ECR_REGISTRY')
    DOKPLOY_API_TOKEN = credentials('DOKPLOY_API_TOKEN')
    DOKPLOY_URL       = credentials('DOKPLOY_URL')
  }

  stages {
    stage('List Recent Tags') {
      when {
        expression { params.TARGET_TAG == '' }
      }
      steps {
        sh '''
          echo "Recent tags for fleet-${SERVICE}:"
          aws ecr describe-images \
            --region ${AWS_REGION} \
            --repository-name fleet-${SERVICE} \
            --query 'sort_by(imageDetails, &imagePushedAt)[-10:].imageTags[0]' \
            --output table
        '''
        error('Provide TARGET_TAG to proceed with rollback.')
      }
    }

    stage('Validate Tag') {
      steps {
        sh '''
          echo "Validating tag ${TARGET_TAG} for fleet-${SERVICE}..."
          aws ecr describe-images \
            --region ${AWS_REGION} \
            --repository-name fleet-${SERVICE} \
            --image-ids imageTag=${TARGET_TAG}
          echo "Tag found."
        '''
      }
    }

    stage('Production Approval') {
      when {
        expression { params.ENVIRONMENT == 'prod' }
      }
      steps {
        input(
          message: "Roll back fleet-${params.SERVICE} to ${params.TARGET_TAG} in PRODUCTION?",
          ok: 'Proceed'
        )
      }
    }

    stage('Deploy') {
      steps {
        sh '''
          curl -s -X POST \
            -H "Authorization: Bearer ${DOKPLOY_API_TOKEN}" \
            -H "Content-Type: application/json" \
            -d "{\"tag\": \"${TARGET_TAG}\"}" \
            "${DOKPLOY_URL}/api/application/deploy"
          echo "Deploy triggered."
        '''
      }
    }

    stage('Health Check') {
      steps {
        sh '''
          python3 hussle-app-dispatch-infra/scripts/health-check.sh ${ENVIRONMENT} || true
        '''
      }
    }
  }

  post {
    success {
      echo "Rollback of fleet-${params.SERVICE} to ${params.TARGET_TAG} in ${params.ENVIRONMENT} succeeded."
    }
    failure {
      echo "Rollback failed. Check logs above."
    }
  }
}
